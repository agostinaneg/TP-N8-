#include <iostream>
#include <vector>
#include <string>

using namespace std;

class Alumno {
private:
    string nombre;
    double nota1, nota2, nota3;

public:
    Alumno(string n, double n1, double n2, double n3) {
        nombre = n;
        nota1 = n1;
        nota2 = n2;
        nota3 = n3;
    }

    string getNombre() { return nombre; }
    double getNota1() { return nota1; }
    double getNota2() { return nota2; }
    double getNota3() { return nota3; }

    double calcularPromedio() {
        return (nota1 + nota2 + nota3) / 3.0;
    }
};

int main() {
    vector<Alumno> alumnos;
    int cant;

    cout << "Ingrese la cantidad de alumnos: ";
    cin >> cant;

    for (int i = 0; i < cant; i++) {
        string nom;
        double n1, n2, n3;
        cout << "\n--- Alumno " << i + 1 << " ---\n";
        cout << "Nombre: ";
        cin >> nom;
        cout << "Nota 1: "; cin >> n1;
        cout << "Nota 2: "; cin >> n2;
        cout << "Nota 3: "; cin >> n3;

        alumnos.push_back(Alumno(nom, n1, n2, n3));
    }

    cout << "\n=== LISTA DE ALUMNOS ===\n";
    for (int i = 0; i < alumnos.size(); i++) {
        cout << "Nombre: " << alumnos[i].getNombre() << "\n";
        cout << "Notas: " << alumnos[i].getNota1() << ", " << alumnos[i].getNota2() << ", " << alumnos[i].getNota3() << "\n";
        cout << "Promedio: " << alumnos[i].calcularPromedio() << "\n";
        cout << "-----------------------\n";
    }

    return 0;
}
